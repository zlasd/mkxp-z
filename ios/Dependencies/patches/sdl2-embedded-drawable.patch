+- (void)setMaouHostView:(UIView *)host
+{
+    _maouHostView = host;
+    if (host) maouDeferredDrawable = YES;
+    SDL_AtomicSet(&maouLayoutPending, 1);
+    [self setNeedsLayout];
+}
