+- (BOOL)maouSyncDrawableWidth:(int *)width height:(int *)height scale:(float *)scale
+{
+    if (!SDL_AtomicSet(&maouLayoutPending, 0)) {
+        return NO;
+    }
+    /* Called at a frame boundary by the sole render thread. Drain GPU work
+     * before storage destruction, then temporarily lend the context to UIKit.
+     * No main-thread wait holds a lock needed by UIKit or by session shutdown. */
+    SDL_assert(![NSThread isMainThread]);
+    EAGLContext *renderContext = [EAGLContext currentContext];
+    SDL_assert(renderContext == context);
+    glFinish();
+    [EAGLContext setCurrentContext:nil];
+    __block BOOL valid = NO;
+    dispatch_sync(dispatch_get_main_queue(), ^{
+        [self.superview layoutIfNeeded];
+        [self layoutIfNeeded];
+        int w = (int)(self.bounds.size.width * self.contentScaleFactor);
+        int h = (int)(self.bounds.size.height * self.contentScaleFactor);
+        if (w <= 0 || h <= 0) {
+            SDL_AtomicSet(&maouLayoutPending, 1);
+            return;
+        }
+        EAGLContext *previous = [EAGLContext currentContext];
+        [EAGLContext setCurrentContext:self->context];
+        if (w != self->backingWidth || h != self->backingHeight) {
+            [self updateFrame];
+        }
+        glFlush();
+        [EAGLContext setCurrentContext:previous == self->context ? nil : previous];
+        *width = self->backingWidth;
+        *height = self->backingHeight;
+        *scale = self.contentScaleFactor;
+        valid = YES;
+    });
+    [EAGLContext setCurrentContext:renderContext];
+    return valid;
+}
